local function getOtherPlayers()
	local list = {}
	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then table.insert(list, target) end
	end
	return list
end

local function hasWeapon(character)
	if not character then return false end
	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Tool") then
			return true
		end
	end
	return false
end

local function getClosestArmedPlayer(maxDistance)
	maxDistance = maxDistance or 500
	local myChar = player.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end

	local myPos = myChar.HumanoidRootPart.Position
	local closestChar = nil
	local shortestDistance = maxDistance

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player and target.Character then
			local char = target.Character
			local root = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			
			if root and hum and hum.Health > 0 and hasWeapon(char) then
				local dist = (root.Position - myPos).Magnitude
				if dist < shortestDistance then
					shortestDistance = dist
					closestChar = char
				end
			end
		end
	end
	return closestChar
end

