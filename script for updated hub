--==================================================
-- HASH & KEY VERIFICATION LOGIC
--==================================================

local function base32Decode(input)
	local result = {}
	local buffer = 0
	local bitsLeft = 0

	for i = 1, #input do
		local char = string.sub(input, i, i)
		local val = string.find(ALPHABET, char, 1, true)
		if val then
			buffer = (buffer * 32) + (val - 1)
			bitsLeft = bitsLeft + 5
			if bitsLeft >= 8 then
				bitsLeft = bitsLeft - 8
				local byte = math.floor(buffer / (2 ^ bitsLeft)) % 256
				table.insert(result, byte)
			end
		end
	end
	return result
end

local function verifyKey(key)
	key = string.gsub(key, "%s+", "")
	
	-- Admin Key Check
	if key == ADMIN_KEY then
		return true
	end
	
	key = string.upper(key)
	if #key < 8 then return false end
	
	local bytes = base32Decode(key)
	if #bytes < 4 then return false end
	
	local hashSum = 0
	for i = 1, #bytes do
		hashSum = (hashSum + bytes[i] * i) % 256
	end
	
	return hashSum % 2 == 0
end

