-- CONTINUOUS CHARACTER ATTR LOOP (SPEED, JUMP, NOCLIP & INVISIBILITY)
RunService.Stepped:Connect(function()
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			-- Enforce Speed & Jump
			hum.WalkSpeed = WALK_SPEED
			hum.UseJumpPower = true
			hum.JumpPower = SUPER_JUMP_ENABLED and SUPER_JUMP or NORMAL_JUMP

			if GOD_ENABLED then
				if hum.Health < hum.MaxHealth then
					hum.Health = hum.MaxHealth
				end
				hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
			end
		end

		if INVIS_ENABLED then
			setCharacterInvisibility(true)
		end

		if NOCLIP_ENABLED then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					part.CanCollide = false
				end
			end
		end
	end
end)

-- RENDERSTEPPED LOOP (ESP, ENHANCED CORNER TRACKING AIMBOT, & LOCK ON)
RunService.RenderStepped:Connect(function(dt)
	if ESP_ENABLED then
		for _, target in ipairs(getOtherPlayers()) do
			if target.Character and not highlights[target] then
				local hl = Instance.new("Highlight")
				hl.FillColor = THEME.ACCENT
				hl.OutlineColor = THEME.ACCENT
				hl.Parent = target.Character
				highlights[target] = hl
			end
		end
	end

	if AIM_ENABLED and not LOCK_ENABLED then
		local targetChar = getClosestArmedPlayer(500)
		if targetChar then
			local aimPart = targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart")
			if aimPart then
				local targetPos = aimPart.Position
				local targetCFrame = CFrame.lookAt(camera.CFrame.Position, targetPos)
				camera.CFrame = camera.CFrame:Lerp(targetCFrame, math.min(dt * 25, 1))
			end
		end
	end

	if LOCK_ENABLED then
		if aimTarget and aimTarget:FindFirstChild("HumanoidRootPart") and hasWeapon(aimTarget) then
			local targetHum = aimTarget:FindFirstChildOfClass("Humanoid")
			local myChar = player.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

			if targetHum and targetHum.Health > 0 and myRoot then
				local targetPart = aimTarget:FindFirstChild("Head") or aimTarget.HumanoidRootPart
				camera.CameraType = Enum.CameraType.Scriptable
				
				local goalCFrame = CFrame.lookAt(camera.CFrame.Position, targetPart.Position)
				camera.CFrame = camera.CFrame:Lerp(goalCFrame, math.min(dt * 25, 1))
			else
				LOCK_ENABLED = false
				aimTarget = nil
				camera.CameraType = Enum.CameraType.Custom
				lockButton.Text = "LOCK ON: OFF"
			end
		else
			LOCK_ENABLED = false
			aimTarget = nil
			camera.CameraType = Enum.CameraType.Custom
			lockButton.Text = "LOCK ON: OFF"
		end
	end
end)

