-- Helper to set visibility across character items
local function setCharacterInvisibility(state)
	local char = player.Character
	if not char then return end

	if state then
		for _, v in ipairs(char:GetDescendants()) do
			if v:IsA("BasePart") then
				if not savedCharacterStates[v] then
					savedCharacterStates[v] = { Transparency = v.Transparency }
				end
				v.Transparency = 1
				v.LocalTransparencyModifier = 0.5
			elseif v:IsA("Decal") or v:IsA("Texture") then
				if not savedCharacterStates[v] then
					savedCharacterStates[v] = { Transparency = v.Transparency }
				end
				v.Transparency = 1
			elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Light") then
				if not savedCharacterStates[v] then
					savedCharacterStates[v] = { Enabled = v.Enabled }
				end
				v.Enabled = false
			end
		end
	else
		for obj, props in pairs(savedCharacterStates) do
			if obj and obj.Parent then
				if props.Transparency ~= nil then
					obj.Transparency = props.Transparency
					if obj:IsA("BasePart") then
						obj.LocalTransparencyModifier = props.Transparency
					end
				end
				if props.Enabled ~= nil then
					obj.Enabled = props.Enabled
				end
			end
		end
		savedCharacterStates = {}
	end
end

-- ADVANCED GOD MODE HANDLER (Bypasses Local Health Overrides)
local function applyGodMode(char)
	if not char then return end
	local hum = char:WaitForChild("Humanoid", 3)
	if not hum then return end

	-- Clean up existing connections
	for _, conn in ipairs(godConnections) do
		conn:Disconnect()
	end
	godConnections = {}

	if GOD_ENABLED then
		-- Lock damage state types
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

		-- Continuously restore health on change
		local healthConn = hum.HealthChanged:Connect(function(newHealth)
			if GOD_ENABLED and newHealth < hum.MaxHealth then
				hum.Health = hum.MaxHealth
			end
		end)
		table.insert(godConnections, healthConn)

		-- Prevent breakage/death if server forces health to 0
		local stateConn = hum.StateChanged:Connect(function(_, new)
			if GOD_ENABLED and new == Enum.HumanoidStateType.Dead then
				hum:ChangeState(Enum.HumanoidStateType.Running)
				hum.Health = hum.MaxHealth
			end
		end)
		table.insert(godConnections, stateConn)
		
		hum.Health = hum.MaxHealth
	else
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
	end
end

