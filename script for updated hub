local checkpointButton = makeButton(tpPanel, "AUTO CHECKPOINTS: OFF", 38)
local skipButton = makeButton(tpPanel, "TP TO LAST SLOT", 38)

local CHECKPOINT_DELAY = 0.3
local checkpointRunning = false

local function getCheckpoints()
	local entries = {}
	for _, item in ipairs(workspace:GetDescendants()) do
		if item:IsA("BasePart") or item:IsA("SpawnLocation") or item:IsA("Model") then
			local num = tonumber(string.match(item.Name, "%d+"))
			if num then table.insert(entries, { item = item, number = num }) end
		end
	end
	table.sort(entries, function(a, b) return a.number < b.number end)
	return entries
end

checkpointButton.Activated:Connect(function()
	checkpointRunning = not checkpointRunning
	checkpointButton.Text = "AUTO CHECKPOINTS: " .. (checkpointRunning and "ON" or "OFF")

	if checkpointRunning then
		task.spawn(function()
			local points = getCheckpoints()
			for _, entry in ipairs(points) do
				if not checkpointRunning then break end
				local root = getRoot()
				if root and entry.item then
					local targetCF = entry.item:IsA("Model") and entry.item:GetPivot() or entry.item.CFrame
					root.CFrame = targetCF + Vector3.new(0, 3, 0)
					task.wait(CHECKPOINT_DELAY)
				end
			end
			checkpointRunning = false
			checkpointButton.Text = "AUTO CHECKPOINTS: OFF"
		end)
	end
end)

skipButton.Activated:Connect(function()
	local points = getCheckpoints()
	if #points > 0 then
		local last = points[#points]
		local root = getRoot()
		if root and last.item then
			local targetCF = last.item:IsA("Model") and last.item:GetPivot() or last.item.CFrame
			root.CFrame = targetCF + Vector3.new(0, 3, 0)
			skipButton.Text = "TELEPORTED TO END!"
			task.delay(1.5, function() skipButton.Text = "TP TO LAST SLOT" end)
		end
	else
		skipButton.Text = "NO CHECKPOINTS FOUND"
		task.delay(1.5, function() skipButton.Text = "TP TO LAST SLOT" end)
	end
end)