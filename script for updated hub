local function updateFlySpeed(inputX)
	local sliderX = flySpeedSlider.AbsolutePosition.X
	local sliderWidth = flySpeedSlider.AbsoluteSize.X
	if sliderWidth <= 0 then return end

	local percent = math.clamp((inputX - sliderX) / sliderWidth, 0, 1)
	FLY_SPEED = math.floor(10 + (190 * percent) + 0.5)

	flySpeedLabel.Text = "FLY SPEED: " .. FLY_SPEED
	flySpeedFill.Size = UDim2.new(percent, 0, 1, 0)
	flySpeedKnob.Position = UDim2.new(percent, 0, 0.5, 0)
end

